# Copy to .env and fill in. .env is gitignored - never commit it.
#
# Any OpenAI-compatible endpoint works. The URL must end in /v1.
#   uni platform     https://<host>/api/v1      (Open-WebUI style)
#   Ollama           http://localhost:11434/v1  (key can be any non-empty string)
#   LM Studio        http://localhost:1234/v1
#   OpenAI           https://api.openai.com/v1

LLM_BASE_URL=
LLM_API_KEY=
